# ============================================================
#  LAN File Share - nginx config (Linux / WSL)
#
#  Do NOT edit this file by hand - run "bash setup.sh", which fills
#  in your real paths and username and writes the finished config to
#  ~/fileshare/nginx.conf .
#
#  Runs on port 8080 as your normal user (no sudo required).
#  Everything lives under one folder, so nothing in /etc/nginx
#  is touched.
# ============================================================

worker_processes  1;

# run workers as you, so the share folder stays writable
user             __USER__;

pid              __SHARE__/nginx.pid;
error_log        __SHARE__/logs/error.log warn;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    access_log    __SHARE__/logs/access.log;

    sendfile            on;
    keepalive_timeout   65;

    # uploads are staged here first, then moved into place.
    # keep this on the same filesystem as the data dir.
    client_body_temp_path   __SHARE__/temp;

    server {
        listen       8080;
        server_name  _;

        # ---------- login (protects everything below) ----------
        auth_basic           "LAN File Share";
        auth_basic_user_file __SHARE__/conf/.htpasswd;

        # ---------- the web UI, at http://<host>:8080/ ----------
        location = / {
            root   __SHARE__/www;
            index  index.html;
        }

        # ---------- shared files: list / download / upload / delete / rename ----------
        location /files/ {
            alias                 __SHARE__/data/;

            autoindex             on;
            autoindex_format      json;     # the UI reads this to list files
            autoindex_exact_size  off;
            autoindex_localtime   on;

            # WebDAV: PUT=upload  DELETE=delete  MKCOL=new folder  MOVE=rename
            dav_methods           PUT DELETE MKCOL MOVE COPY;
            create_full_put_path  on;
            dav_access            user:rw group:rw all:r;

            client_max_body_size  0;        # 0 = no upload size limit

            # nobody can delete the /files/ root itself
            min_delete_depth      2;
        }

        location / {
            return 302 /;
        }
    }
}
