# ------------------------------------------------------------
#  Password file for nginx basic auth (Linux / WSL).
#  setup.sh copies this to  ~/fileshare/conf/.htpasswd
#
#  One account per line, in the form:   username:password
#  Lines starting with '#' and blank lines are ignored.
#
#  Simplest option: a plain-text password, e.g.
#      john:MySecret123
#
#  Prefer a hash? Generate one (works on Linux nginx too):
#      openssl passwd -apr1 MySecret123
#      ->  $apr1$xxxxxxxx$yyyyyyyyyyyyyyyyyyyyyyyyyy
#  then write:
#      john:$apr1$xxxxxxxx$yyyyyyyyyyyyyyyyyyyyyyyyyy
# ------------------------------------------------------------

# Replace the line below with your own username:password
john:change-me
